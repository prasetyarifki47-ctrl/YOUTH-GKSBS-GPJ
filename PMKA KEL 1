        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.svm import SVC\n",
        "from sklearn.metrics import classification_report, confusion_matrix, accuracy_score\n",
        "\n",
        "# 1. LOAD DATASET\n",
        "df = pd.read_csv('indonesia_kualitas_udara_ispu_enriched.csv')\n",
        "print(\"Ukuran Dataset:\", df.shape)\n",
        "print(\"\\n5 Baris Pertama:\")\n",
        "print(df.head())\n",
        "\n",
        "# 2. PEMILIHAN FITUR (FEATURE SELECTION) & TARGET\n",
        "# Hanya menggunakan 10 parameter sensor gas/partikulat & cuaca untuk mencegah data leakage\n",
        "fitur_sensor = [\n",
        "    'pm25_concentration_ugm3',\n",
        "    'pm10_concentration_ugm3',\n",
        "    'sulfur_dioxide_so2_ugm3',\n",
        "    'nitrogen_dioxide_no2_ugm3',\n",
        "    'carbon_monoxide_co_ugm3',\n",
        "    'ozone_o3_ugm3',\n",
        "    'ambient_temperature_celsius',\n",
        "    'relative_humidity_pct',\n",
        "    'wind_speed_kmh',\n",
        "    'rainfall_intensity_mm'\n",
        "]\n",
        "\n",
        "target_col = 'ispu_category'\n",
        "\n",
        "# Hapus baris kosong atau duplikat jika ada\n",
        "df_clean = df[fitur_sensor + [target_col]].dropna().drop_duplicates()\n",
        "\n",
        "X = df_clean[fitur_sensor]\n",
        "y = df_clean[target_col]\n",
        "\n",
        "# 3. ENCODING LABEL & SPLITTING DATA (80:20)\n",
        "le = LabelEncoder()\n",
        "y_encoded = le.fit_transform(y)\n",
        "class_names = le.classes_\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y_encoded, test_size=0.2, random_state=42, stratify=y_encoded\n",
        ")\n",
        "\n",
        "# 4. STANDARISASI FITUR (Wajib untuk SVM)\n",
        "scaler = StandardScaler()\n",
        "X_train_scaled = scaler.fit_transform(X_train)\n",
        "X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "# 5. EXPLORATORY DATA ANALYSIS (EDA)\n",
        "plt.figure(figsize=(14, 5))\n",
        "\n",
        "plt.subplot(1, 2, 1)\n",
        "order_kelas = ['Baik', 'Sedang', 'Tidak Sehat', 'Sangat Tidak Sehat', 'Berbahaya']\n",
        "sns.countplot(x=y, order=order_kelas, palette='viridis')\n",
        "plt.title('Distribusi Kategori Kualitas Udara (ISPU)')\n",
        "plt.xlabel('Kategori ISPU')\n",
        "plt.ylabel('Jumlah Data')\n",
        "plt.xticks(rotation=25)\n",
        "\n",
        "plt.subplot(1, 2, 2)\n",
        "sns.heatmap(X.corr(), annot=True, cmap='coolwarm', fmt='.2f', annot_kws={'size': 8})\n",
        "plt.title('Korelasi Antar Parameter Sensor')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 6. PELATIHAN MODEL (RANDOM FOREST & SVM)\n",
        "rf_model = RandomForestClassifier(n_estimators=100, random_state=42)\n",
        "rf_model.fit(X_train_scaled, y_train)\n",
        "y_pred_rf = rf_model.predict(X_test_scaled)\n",
        "\n",
        "svm_model = SVC(kernel='rbf', C=1.0, random_state=42)\n",
        "svm_model.fit(X_train_scaled, y_train)\n",
        "y_pred_svm = svm_model.predict(X_test_scaled)\n",
        "\n",
        "# 7. EVALUASI PERFORMA MODEL\n",
        "print(\"\\n=== HASIL EVALUASI RANDOM FOREST ===\")\n",
        "print(f\"Akurasi: {accuracy_score(y_test, y_pred_rf)*100:.2f}%\")\n",
        "print(classification_report(y_test, y_pred_rf, target_names=class_names))\n",
        "\n",
        "print(\"=== HASIL EVALUASI SVM ===\")\n",
        "print(f\"Akurasi: {accuracy_score(y_test, y_pred_svm)*100:.2f}%\")\n",
        "print(classification_report(y_test, y_pred_svm, target_names=class_names))\n",
        "\n",
        "# Visualisasi Confusion Matrix Berdampingan\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "sns.heatmap(confusion_matrix(y_test, y_pred_rf), annot=True, fmt='d', cmap='Blues',\n",
        "            xticklabels=class_names, yticklabels=class_names, ax=axes[0])\n",
        "axes[0].set_title('Confusion Matrix - Random Forest')\n",
        "axes[0].set_xlabel('Prediksi')\n",
        "axes[0].set_ylabel('Aktual')\n",
        "\n",
        "sns.heatmap(confusion_matrix(y_test, y_pred_svm), annot=True, fmt='d', cmap='Greens',\n",
        "            xticklabels=class_names, yticklabels=class_names, ax=axes[1])\n",
        "axes[1].set_title('Confusion Matrix - SVM')\n",
        "axes[1].set_xlabel('Prediksi')\n",
        "axes[1].set_ylabel('Aktual')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Visualisasi Feature Importance (Random Forest)\n",
        "plt.figure(figsize=(9, 5))\n",
        "importances = pd.Series(rf_model.feature_importances_, index=fitur_sensor).sort_values(ascending=True)\n",
        "importances.plot(kind='barh', color='teal')\n",
        "plt.title('Tingkat Pengaruh Parameter Sensor (Feature Importance)')\n",
        "plt.xlabel('Skor Kepentingan')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 8. SIMULASI PREDIKSI DATA SENSOR BARU (UNTUK DEMONSTRASI)\n",
        "sample_input = X_test.iloc[[0]]\n",
        "sample_scaled = scaler.transform(sample_input)\n",
        "pred_rf_sample = le.inverse_transform(rf_model.predict(sample_scaled))[0]\n",
        "pred_svm_sample = le.inverse_transform(svm_model.predict(sample_scaled))[0]\n",
        "aktual_sample = le.inverse_transform([y_test[0]])[0]\n",
        "\n",
        "print(\"\\n=== SIMULASI PREDIKSI DATA UJI ===\")\n",
        "print(\"Nilai Input Sensor:\\n\", sample_input.to_dict(orient='records')[0])\n",
        "print(f\"Label Aktual           : {aktual_sample}\")\n",
        "print(f\"Prediksi Random Forest : {pred_rf_sample}\")\n",
        "print(f\"Prediksi SVM           : {pred_svm_sample}\")"
      ]
    }
