<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jika mengakses file atau folder fisik yang ada, tampilkan langsung
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Arahkan route Next.js ke index.html
  RewriteRule ^ index.html [L]
</IfModule>