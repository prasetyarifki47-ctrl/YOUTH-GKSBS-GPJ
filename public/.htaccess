<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Biarkan file dan folder fisik yang ada terbuka langsung
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Arahkan route Next.js dinamis ke index.html
  RewriteRule ^ index.html [L]
</IfModule>